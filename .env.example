# Copy to .env and fill in. Never commit .env.

# Neon Postgres. Use the pooled URL for the app; the direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET="replace-me"

# The single allowed address. This is the whole allowlist.
ALLOWED_EMAIL="you@example.com"

# Magic-link email delivery (SMTP). Any transactional SMTP provider works.
EMAIL_SERVER="smtp://user:password@smtp.host:587"
EMAIL_FROM="fini <no-reply@yourdomain.com>"
