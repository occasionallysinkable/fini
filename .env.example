# Copy real values into .env.local (gitignored). Never commit secrets.

# Neon Postgres. Use the pooled URL for the app; the direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# The single allowed address. This is the whole allowlist.
ALLOWED_EMAIL="you@example.com"

# Magic-link delivery via Resend. The provider sends from onboarding@resend.dev.
RESEND_API_KEY="re_xxxxxxxx"

# WP7 — Web Push (VAPID). Generate a keypair with: npx web-push generate-vapid-keys
# The public key is also shipped to the browser (NEXT_PUBLIC_). The subject is a
# contact the push service can reach.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-me"
VAPID_PRIVATE_KEY="replace-me"
VAPID_SUBJECT="mailto:you@example.com"

# WP7 — shared secret the Cloudflare tick cron sends to /api/tick. Set the SAME
# value on the Worker (wrangler secret put CRON_SECRET). Without it, /api/tick
# refuses every request.
CRON_SECRET="a-long-random-string"
