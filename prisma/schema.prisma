// WP1 — the whole data model goes in now, including the columns nothing reads
// until stage 3 (the do-date split, the placed-by flags, the task-to-task links).
// Adding them later is a migration across live data; adding them now is free.
//
// Naming: Prisma fields are camelCase; every table and column is @map'd to the
// snake_case names the handoff uses, so the database matches the contract.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — the closed sets named in the data model. Words, never colours.
// ---------------------------------------------------------------------------

enum ActorKind {
  user
  app
  person
}

enum ActivityFilterKind {
  reminders
  overrides
  dates
  people
  deletions
}

enum TaskKind {
  commitment
  own
  habit
  unassigned
}

enum TaskStatus {
  active
  done
  cancelled
  someday
}

enum SetBy {
  user
  app
}

enum HillState {
  figuring
  doing
}

enum TaskSource {
  typed
  voice
  email
  meeting
  message
}

enum TaskRole {
  asked_by
  waiting_on
  delegated_to
  assignee
}

enum BlockerState {
  waiting
  late
  cleared
}

enum ReminderOutcome {
  fired
  done
  snoozed
  withdrawn
}

enum SnoozeReason {
  middle_of_something
  wrong_time_of_day
  waiting_on_someone
}

enum RecurrencePattern {
  daily
  weekdays
  weekly
  monthly_date
  every_n_weeks
}

enum RecurrenceMode {
  fixed
  after_completion
}

enum OverrideReasonCode {
  matters_more
  estimate_wrong
  wrong_time
  fresh_info
  free_text
}

enum OverridePointsAt {
  rejected
  chosen
  both
}

enum EngagementKind {
  open
  planning_finished
  capture
}

enum Platform {
  desktop
  mobile
}

// ---------------------------------------------------------------------------
// user — one row. Also serves as the Auth.js user (single-address allowlist),
// so the app keeps exactly one user table. The life-specific fields
// (timezone, planning hour, waking hours) are nullable and set by the user,
// never hard-coded (invariant 12).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?

  timezone     String?
  planningHour Int?    @map("planning_hour")
  wakingStart  String? @map("waking_start")
  wakingEnd    String? @map("waking_end")
  settings     Json?

  accounts Account[]
  sessions Session[]

  @@map("user")
}

model Person {
  id        String   @id @default(cuid())
  name      String
  timezone  String?
  dayStart  String?  @map("day_start")
  dayEnd    String?  @map("day_end")
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")

  taskPeople TaskPerson[]
  blockers   Blocker[]
  activities Activity[]

  @@map("person")
}

model Project {
  id                 String     @id @default(cuid())
  name               String
  parentId           String?    @map("parent_id")
  isSequence         Boolean    @default(false) @map("is_sequence")
  onHold             Boolean    @default(false) @map("on_hold")
  reviewIntervalDays Int?       @map("review_interval_days")
  lastReviewedAt     DateTime?  @map("last_reviewed_at")
  hillState          HillState? @map("hill_state")

  // Soft-delete (invariant 2): a deleted project sets deleted_at and nothing
  // else, and undo clears it. Deleting a project cascades to its sub-projects
  // and their tasks as one reversible set. Views exclude deleted_at IS NOT NULL
  // in their queries — never in isAvailable(), which only governs live tasks.
  deletedAt DateTime? @map("deleted_at")

  parent   Project?  @relation("ProjectTree", fields: [parentId], references: [id])
  children Project[] @relation("ProjectTree")
  tasks    Task[]

  @@map("project")
}

model Category {
  id   String @id @default(cuid())
  name String

  tasks           Task[]
  shiftCategories ShiftCategory[]

  @@map("category")
}

model Task {
  id             String      @id @default(cuid())
  title          String
  // WP3 — explicit order of a task within its project. Sequence projects offer
  // their first unfinished step, and "first" means lowest position, not oldest
  // row: ordering by createdAt could neither insert a step into the middle nor
  // reorder steps. WP4's board and WP8's recurrence read this same order.
  position       Int         @default(0)
  projectId      String?     @map("project_id")
  categoryId     String?     @map("category_id")
  kind           TaskKind    @default(unassigned)
  kindIsExplicit Boolean     @default(false) @map("kind_is_explicit")
  reason         String?
  status         TaskStatus  @default(active)
  dueDate        DateTime?   @map("due_date") @db.Date
  dueTime        String?     @map("due_time")
  dueAtUtc       DateTime?   @map("due_at_utc")
  dueZone        String?     @map("due_zone")
  doDate         DateTime?   @map("do_date") @db.Date
  doDateSetBy    SetBy?      @map("do_date_set_by")
  deferUntil     DateTime?   @map("defer_until") @db.Date
  estimateMinutes Int?       @map("estimate_minutes")
  actualMinutes  Int?        @map("actual_minutes")
  splittable     Boolean     @default(false)
  minChunkMinutes Int?       @map("min_chunk_minutes")
  hillState      HillState?  @map("hill_state")
  blockStart     DateTime?   @map("block_start")
  blockEnd       DateTime?   @map("block_end")
  blockPlacedBy  SetBy?      @map("block_placed_by")
  recurrenceRuleId String?   @map("recurrence_rule_id")
  occurrenceDate DateTime?   @map("occurrence_date") @db.Date
  source         TaskSource?
  pushCount      Int         @default(0) @map("push_count")
  keepCount      Int         @default(0) @map("keep_count")
  createdAt      DateTime    @default(now()) @map("created_at")
  modifiedAt     DateTime    @updatedAt @map("modified_at")
  completedAt    DateTime?   @map("completed_at")
  deletedAt      DateTime?   @map("deleted_at")

  project        Project?         @relation(fields: [projectId], references: [id])
  category       Category?        @relation(fields: [categoryId], references: [id])
  recurrenceRule RecurrenceRule?  @relation(fields: [recurrenceRuleId], references: [id])
  taskPeople     TaskPerson[]
  blockers       Blocker[]
  reminders      Reminder[]
  notes          Note[]
  activities     Activity[]
  dependencies   TaskDependency[] @relation("TaskBlocked")
  dependents     TaskDependency[] @relation("TaskBlocking")

  @@map("task")
}

model TaskPerson {
  taskId   String   @map("task_id")
  personId String   @map("person_id")
  role     TaskRole

  task   Task   @relation(fields: [taskId], references: [id])
  person Person @relation(fields: [personId], references: [id])

  @@id([taskId, personId, role])
  @@map("task_person")
}

model Blocker {
  id         String       @id @default(cuid())
  taskId     String       @map("task_id")
  personId   String?      @map("person_id")
  eventText  String?      @map("event_text")
  expectedBy DateTime?    @map("expected_by") @db.Date
  state      BlockerState @default(waiting)
  createdAt  DateTime     @default(now()) @map("created_at")
  clearedAt  DateTime?    @map("cleared_at")

  task   Task    @relation(fields: [taskId], references: [id])
  person Person? @relation(fields: [personId], references: [id])

  @@map("blocker")
}

model TaskDependency {
  taskId          String @map("task_id")
  blockedByTaskId String @map("blocked_by_task_id")

  task          Task @relation("TaskBlocked", fields: [taskId], references: [id])
  blockedByTask Task @relation("TaskBlocking", fields: [blockedByTaskId], references: [id])

  @@id([taskId, blockedByTaskId])
  @@map("task_dependency")
}

model Reminder {
  id              String    @id @default(cuid())
  taskId          String    @map("task_id")
  offsetMinutes   Int?      @map("offset_minutes")
  absoluteAt      DateTime? @map("absolute_at")
  isStartReminder Boolean   @default(false) @map("is_start_reminder")
  enabled         Boolean   @default(true)
  nextFireAtUtc   DateTime? @map("next_fire_at_utc")
  snoozeCount     Int       @default(0) @map("snooze_count")
  createdAt       DateTime  @default(now()) @map("created_at")

  task   Task            @relation(fields: [taskId], references: [id])
  events ReminderEvent[]

  @@map("reminder")
}

model ReminderEvent {
  id               String          @id @default(cuid())
  reminderId       String          @map("reminder_id")
  firedAt          DateTime        @map("fired_at")
  devicesDelivered Int?            @map("devices_delivered")
  outcome          ReminderOutcome
  snoozeReason     SnoozeReason?   @map("snooze_reason")
  snoozeMinutes    Int?            @map("snooze_minutes")

  reminder Reminder @relation(fields: [reminderId], references: [id])

  @@map("reminder_event")
}

model Shift {
  id                 String    @id @default(cuid())
  name               String
  startTime          String    @map("start_time")
  endTime            String    @map("end_time")
  weekdays           Boolean[]
  capacityMinutes    Int?      @map("capacity_minutes")
  capacityFromWindow Boolean   @default(true) @map("capacity_from_window")
  createdAt          DateTime  @default(now()) @map("created_at")

  shiftCategories ShiftCategory[]

  @@map("shift")
}

model ShiftCategory {
  shiftId    String @map("shift_id")
  categoryId String @map("category_id")

  shift    Shift    @relation(fields: [shiftId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([shiftId, categoryId])
  @@map("shift_category")
}

model RecurrenceRule {
  id         String            @id @default(cuid())
  pattern    RecurrencePattern
  weekdays   Boolean[]
  dayOfMonth Int?              @map("day_of_month")
  n          Int?
  mode       RecurrenceMode
  template   Json

  tasks Task[]

  @@map("recurrence_rule")
}

model Note {
  id        String   @id @default(cuid())
  taskId    String?  @map("task_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  task Task? @relation(fields: [taskId], references: [id])

  @@map("note")
}

model Override {
  id             String              @id @default(cuid())
  at             DateTime            @default(now())
  rejectedTaskId String?             @map("rejected_task_id")
  chosenTaskId   String?             @map("chosen_task_id")
  reasonCode     OverrideReasonCode? @map("reason_code")
  reasonText     String?             @map("reason_text")
  pointsAt       OverridePointsAt    @map("points_at")

  @@map("override")
}

model PlanningSession {
  id             String    @id @default(cuid())
  forDate        DateTime  @map("for_date") @db.Date
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  questionCount  Int?      @map("question_count")
  droppedTaskIds Json      @map("dropped_task_ids")
  ranMidDay      Boolean   @default(false) @map("ran_mid_day")

  @@map("planning_session")
}

// activity — invariant 1. Every domain write produces one of these rows, with
// an actor, a summary sentence and an undo payload. The activity log is the
// write path, not a feature bolted on.
model Activity {
  id            String              @id @default(cuid())
  at            DateTime            @default(now())
  actor         ActorKind
  actorPersonId String?             @map("actor_person_id")
  verb          String
  taskId        String?             @map("task_id")
  summary       String
  filterKind    ActivityFilterKind? @map("filter_kind")
  undoPayload   Json?               @map("undo_payload")
  undoExpiresAt DateTime?           @map("undo_expires_at")

  task        Task?   @relation(fields: [taskId], references: [id])
  actorPerson Person? @relation(fields: [actorPersonId], references: [id])

  @@map("activity")
}

model Device {
  id                   String    @id @default(cuid())
  endpoint             String    @unique
  keys                 Json
  label                String?
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  lastSeenAt           DateTime? @map("last_seen_at")

  @@map("device")
}

model SavedView {
  id       String @id @default(cuid())
  name     String
  filter   Json
  columns  Json
  grouping Json?
  sort     Json?
  position Int?

  @@map("saved_view")
}

model EngagementEvent {
  id       String         @id @default(cuid())
  at       DateTime       @default(now())
  kind     EngagementKind
  platform Platform

  @@map("engagement_event")
}

// ---------------------------------------------------------------------------
// Auth.js plumbing for the email magic link. Not part of the domain model —
// these three tables store sessions, linked accounts and the one-time
// verification tokens the magic link needs. The User model above doubles as
// Auth.js's user so there is still exactly one user table.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}
